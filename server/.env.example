AISSTREAM_API_KEY=your-aisstream-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEWSAPI_KEY=your-newsapi-key
ANTHROPIC_API_KEY=sk-ant-...
PERPLEXITY_API_KEY=pplx-...
DATA_GO_KR_KEY=
GICOMS_API_KEY=
PORT=3001

# ── 보안/어뷰징 방어 (프로덕션 권장) ──────────────────────────────────────────
# CORS 허용 오리진(콤마 구분). 미설정 시 전체 허용(로컬 개발). 프로덕션에선 반드시 설정.
ALLOWED_ORIGINS=https://seabird-tau.vercel.app
# rate limit (IP·분당). 미설정 시 기본값 사용.
RATE_LIMIT_API=120       # 전역 /api 분당 요청
RATE_LIMIT_PAID=10       # Claude/Perplexity 유료 엔드포인트 분당 요청
# relay WebSocket 연결 상한
MAX_RELAY_CLIENTS=300    # 전체 동시 연결
MAX_RELAY_PER_IP=6       # IP당 동시 연결
